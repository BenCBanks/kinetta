# Kinetta settings. Everything here is optional: copy this file to .env, fill in what you want, then run
#   docker compose up -d
# again. Never share your .env file - it can hold keys.

# Your time zone (used for new accounts until their phone says otherwise). List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Which port Kinetta listens on (open http://<this computer>:8790)
KINETTA_PORT=8790

# AI coach notes and food-photo estimates (pick one; leave blank to turn AI off). Costs are billed to your own key.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Better US food search: free key from https://fdc.nal.usda.gov/api-key-signup.html (a shared demo key is used without it)
FDC_API_KEY=

# Public https address through Cloudflare Tunnel (docs/connect.md), used with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
# With the tunnel: 1, so the password-guessing limits see each visitor's real address (docs/connect.md). Leave empty without it.
KINETTA_TRUST_CLOUDFLARE=

# The address people use to reach Kinetta (e.g. https://kinetta.example.com). Invite links use it, so they work from anywhere.
KINETTA_PUBLIC_URL=

# Set to 1 to open a public "Join the beta" page at /beta: strangers can ask for an invite, you approve them
# under Me > People. Leave empty to keep it invite-only.
KINETTA_BETA_SIGNUP=

# AI product access: open preserves current access; entitled needs trusted per-account grants.
# Separate from AI/Health consent; no billing is enabled by this setting.
KINETTA_AI_ACCESS_MODE=open
